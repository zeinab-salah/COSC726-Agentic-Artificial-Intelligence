# Copy to .env in this folder. Never commit .env (it is in .gitignore).

# Live mode: web search + a model for the Researcher, Writer, and Reviewer.
# gemini needs a key and has a daily quota; ollama runs locally with no key;
# auto uses Gemini and switches to Ollama for the rest of a run when Gemini fails (for example HTTP 429).
LIVE_PROVIDER=gemini

# Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check which models your key can use: python -m brief.live_check
GEMINI_MODEL=gemini-3.5-flash
# Used once per call when the main model stays busy (429/500/503) after retries. "none" disables it.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Ollama (https://ollama.com). Install it, then: ollama pull qwen2.5:7b
# Also used by the Step 2 baseline.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Context window for live mode. The researcher prompt needs about 4,000 tokens.
# OLLAMA_NUM_CTX=12288

# Optional: extra allow-listed domains for live search, comma separated.
# BRIEF_EXTRA_DOMAINS=example-vendor.com,docs.example.org

# Step 2 baseline only.
LLM_PROVIDER=mock
